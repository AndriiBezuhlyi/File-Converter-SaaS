# APPROVAL REQUIRED before loading. Static candidate; not runtime-validated.
# Only the manual experiment may select this named profile. No exec attachment.
# Sources: Docker AppArmor documentation and bubblewrap 0.8.0 mount setup.
#include <tunables/global>
@{FLUX_RO} = /newroot/{,usr/,usr/**,lib/,lib/**,lib64/,lib64/**,etc/fonts/,etc/fonts/**,etc/ld.so.cache,etc/libreoffice/,etc/libreoffice/**,app/node_modules/,app/node_modules/**,app/engine-process.js,app/conversion-policy.js,app/image-input.js,app/svg-validation.js,app/document-input.js,app/docx-validation.js,input,input.docx,dev/,proc/}

profile flux-ci-bwrap-review flags=(attach_disconnected,mediate_deleted) {
  # Local IPC and loopback setup in a private network namespace only.
  network unix,
  network netlink,
  # Kernel checks during nested namespace setup; these grant no outer caps.
  capability sys_admin,
  capability sys_chroot,
  capability setuid,
  capability setgid,
  capability setpcap,
  capability net_admin,
  # Runtime reads and executable/library mappings; no global file permission.
  / r,
  /{app,app/**,usr,usr/**,lib,lib/**,lib64,lib64/**} mr,
  /{etc,etc/**,proc,proc/**,sys/fs/cgroup,sys/fs/cgroup/**} r,
  # Mapping a newly created user namespace; kernel ownership checks still apply.
  /proc/{self,[0-9]*}/{uid_map,gid_map,setgroups} w,
  # Reads through bwrap's temporary old root: runtime binds and saved proc fd.
  /oldroot/ r,
  /oldroot/{usr/,usr/**,lib/,lib/**,lib64/,lib64/**} r,
  /oldroot/etc/{fonts/,fonts/**,ld.so.cache,libreoffice/,libreoffice/**} r,
  /oldroot/app/node_modules/{,**} r,
  /oldroot/app/apps/backend/dist/worker/modules/conversions/{engine-process,conversion-policy,image-input,svg-validation,document-input,docx-validation}.js r,
  /oldroot/proc/{self,[0-9]*}/{mountinfo,fd/,fd/**} r,
  /oldroot/dev/{null,zero,full,random,urandom,tty} r,
  /oldroot/tmp/{engine-test-*,isolation-test-*,worker-crash-*/attempt-*,flux-probe-*}/input r,
  # Only unchanged-test scratch prefixes and bwrap's staging roots are writable.
  /tmp/ r,
  /tmp/{engine-test-*,isolation-test-*,worker-crash-*,flux-probe-*}{,/**} rwkl,
  /tmp/{newroot,oldroot}/{,**} rwkl,
  /{work,work/**,newroot,newroot/**} rwkl,
  /dev/{null,zero,full,random,urandom,tty} rw,
  /dev/{fd,stdin,stdout,stderr} r,
  /dev/pts/** rw,
  /input{,.docx} r,
  /usr/bin/{prlimit,bwrap,sh,dash,bash,env,unshare,mount,setarch,libreoffice,dirname,basename,readlink,grep,cat,mkdir} ix,
  /usr/local/bin/node ix,
  /{sbin,usr/sbin}/docker-init mrix,
  /usr/lib/libreoffice/program/** ix,
  # The '/' case detaches the former staging root after pivot_root('.', '.').
  # This is namespace-local permission, not a host-namespace access guarantee.
  umount /{,oldroot/,tmp/oldroot/},
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (send,receive) peer=flux-ci-bwrap-review,
  # Proc metadata access only. Debugger attach/trace is deliberately not allowed.
  ptrace (read,readby) peer=flux-ci-bwrap-review,

  deny /proc/* w,
  deny /proc/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/]*}/** w,
  deny /proc/sys/[^k]** w,
  deny /proc/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny /proc/sysrq-trigger rwklx,
  deny /proc/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # A1: Nested user namespace; no host sysctl change.
  userns,
  # A2: One-way propagation before the two root pivots.
  mount options=(rw,rslave,silent) -> /,
  # bwrap 0.8.0 marks the temporary old root private before detaching it.
  mount options=(rw,rprivate,silent) -> /oldroot/,
  # A3: Exact filesystem types, flags and staging destinations.
  mount fstype=tmpfs options=(rw,nosuid,nodev) -> /tmp/,
  mount fstype=tmpfs options=(rw,nosuid,nodev) -> /newroot/{dev,work}/,
  mount fstype=proc options=(rw,nosuid,nodev,noexec) -> /newroot/proc/,
  mount fstype=devpts options=(rw,nosuid,noexec) -> /newroot/dev/pts/,
  # A4: Each source has a specific destination, not a source/destination product.
  mount options=(rw,rbind,silent) /tmp/newroot/ -> /tmp/newroot/,
  mount options=(rw,rbind,silent) /oldroot/usr/ -> /newroot/usr/,
  mount options=(rw,rbind,silent) /oldroot/{lib,usr/lib}/ -> /newroot/lib/,
  mount options=(rw,rbind,silent) /oldroot/{lib64,usr/lib64}/ -> /newroot/lib64/,
  mount options=(rw,rbind,silent) /oldroot/etc/fonts/ -> /newroot/etc/fonts/,
  mount options=(rw,rbind,silent) /oldroot/etc/ld.so.cache -> /newroot/etc/ld.so.cache,
  mount options=(rw,rbind,silent) /oldroot/etc/libreoffice/ -> /newroot/etc/libreoffice/,
  mount options=(rw,rbind,silent) /oldroot/app/node_modules/ -> /newroot/app/node_modules/,
  mount options=(rw,rbind,silent) /oldroot/app/apps/backend/dist/worker/modules/conversions/engine-process.js -> /newroot/app/engine-process.js,
  mount options=(rw,rbind,silent) /oldroot/app/apps/backend/dist/worker/modules/conversions/conversion-policy.js -> /newroot/app/conversion-policy.js,
  mount options=(rw,rbind,silent) /oldroot/app/apps/backend/dist/worker/modules/conversions/image-input.js -> /newroot/app/image-input.js,
  mount options=(rw,rbind,silent) /oldroot/app/apps/backend/dist/worker/modules/conversions/svg-validation.js -> /newroot/app/svg-validation.js,
  mount options=(rw,rbind,silent) /oldroot/app/apps/backend/dist/worker/modules/conversions/document-input.js -> /newroot/app/document-input.js,
  mount options=(rw,rbind,silent) /oldroot/app/apps/backend/dist/worker/modules/conversions/docx-validation.js -> /newroot/app/docx-validation.js,
  # Unchanged tests generate these scratch prefixes; only input is exposed.
  mount options=(rw,rbind,silent) /oldroot/tmp/{engine-test-*,isolation-test-*,worker-crash-*/attempt-*,flux-probe-*}/input -> /newroot/input{,.docx},
  mount options=(rw,rbind,silent) /oldroot/dev/null -> /newroot/input,
  mount options=(rw,rbind,silent) /oldroot/dev/null -> /newroot/dev/null,
  mount options=(rw,rbind,silent) /oldroot/dev/zero -> /newroot/dev/zero,
  mount options=(rw,rbind,silent) /oldroot/dev/full -> /newroot/dev/full,
  mount options=(rw,rbind,silent) /oldroot/dev/random -> /newroot/dev/random,
  mount options=(rw,rbind,silent) /oldroot/dev/urandom -> /newroot/dev/urandom,
  mount options=(rw,rbind,silent) /oldroot/dev/tty -> /newroot/dev/tty,
  # Exact remount flags: read-only is mandatory; inherited relatime is explicit.
  mount options=(ro,remount,bind,nosuid,nodev,silent) -> @{FLUX_RO},
  mount options=(ro,remount,bind,nosuid,nodev,silent,relatime) -> @{FLUX_RO},
  mount options=(ro,remount,bind,nosuid,nodev,noexec,silent) -> @{FLUX_RO},
  mount options=(ro,remount,bind,nosuid,nodev,noexec,silent,relatime) -> @{FLUX_RO},
  # Device binds are temporarily writable before /dev is remounted read-only.
  mount options=(rw,remount,bind,nosuid,noexec,silent) -> /newroot/dev/{null,zero,full,random,urandom,tty},
  mount options=(rw,remount,bind,nosuid,noexec,silent,relatime) -> /newroot/dev/{null,zero,full,random,urandom,tty},
  # A5: Only bwrap's two staging pivots; retain this profile after pivot.
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  pivot_root oldroot=/newroot/ /newroot/,
}
