# Supply real values in an untracked .env.production file.
NODE_ENV=production
POSTGRES_USER=converter
POSTGRES_DB=converter
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=10000
REDIS_PASSWORD=
REDIS_URL=
REDIS_NAMESPACE=converter
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SESSION_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
INFRA_TIMEOUT_MS=5000
HEALTH_CHECK_INTERVAL_MS=5000
SHUTDOWN_TIMEOUT_MS=20000
WORKER_TEMP_DIR=/tmp/converter
PUBLIC_HTTP_PORT=8080
