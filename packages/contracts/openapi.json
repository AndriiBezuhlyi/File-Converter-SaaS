    "/api/v1/guest-session": {
      "post": {
        "operationId": "guestSessionBootstrap",
        "tags": ["Guest access"],
        "summary": "Create or reuse a protected guest context without resetting its trial",
        "description": "Call GET /auth/csrf first; use the same session cookie and synchronizer token. Sets/reuses a separate guest cookie; never returns its token or internal guest ID. A presented invalid/expired guest credential returns 401 GUEST_CREDENTIAL_INVALID, with no replacement context. Explicit X-API-Key is rejected. Reserved/consumed states return 200 here; their 409/401 admission errors belong to future conversion submission. Bootstrap: 30/IP/minute; issuance: 5/IP/15 minutes. All responses are no-store. Cookie survives account login/logout; ownership never transfers. Guest conversion/status/download routes are not implemented by this operation.",
        "security": [],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Exact configured APP_ORIGIN."
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Synchronizer token from GET /auth/csrf."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New or existing guest state, including reserved/consumed",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": ["no-store"]
                }
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Opaque guest cookie with its original absolute Expires; no fresh lifetime on reuse."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestSession"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Auth400"
          },
          "401": {
            "description": "GUEST_CREDENTIAL_INVALID or explicit API key rejected; no automatic replacement context",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": ["no-store"]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Auth403"
          },
          "429": {
            "$ref": "#/components/responses/Auth429"
          },
          "503": {
            "$ref": "#/components/responses/Auth503"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Readiness": {
        "type": "object",
        "required": ["status", "dependencies"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "unavailable"]
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": ["up", "down"]
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "email", "displayName"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Trimmed and normalized to lowercase."
          },
          "displayName": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "Session": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["anonymous"]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "user", "expiresAt"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["authenticated"]
              },
              "user": {
                "$ref": "#/components/schemas/Profile"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time",
                "description": "Current idle expiry, bounded by the absolute session deadline."
              }
            }
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      },
      "Csrf": {
        "type": "object",
        "additionalProperties": false,
        "required": ["csrfToken"],
        "properties": {
          "csrfToken": {
            "type": "string",
            "description": "Keep in memory. Refresh after login/session rotation. Never persist or cache."
          }
        }
      },
      "Accepted": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["accepted"]
          }
        }
      },
      "EmailRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Trimmed and normalized to lowercase."
          }
        }
      },
      "RegistrationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Trimmed and normalized to lowercase."
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "format": "password",
            "description": "Never trimmed or normalized."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Trimmed and normalized to lowercase."
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "format": "password"
          }
        }
      },
      "TokenRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token"],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.[A-Za-z0-9_-]{43}$",
            "description": "Opaque single-use link token; request bodies only, never query parameters."
          }
        }
      },
      "PasswordResetRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token", "newPassword"],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.[A-Za-z0-9_-]{43}$",
            "description": "Opaque single-use link token; request bodies only, never query parameters."
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "format": "password",
            "description": "Never trimmed or normalized."
          }
        }
      },
      "ProfileUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "displayName", "currentPassword"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Trimmed and normalized to lowercase."
          },
          "displayName": {
            "type": "string",
            "maxLength": 80,
            "description": "Trimmed; empty string clears the display name."
          },
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "format": "password"
          }
        }
      },
      "PasswordChangeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "format": "password"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "format": "password",
            "description": "Never trimmed or normalized."
          }
        }
      },
      "ProfileUpdateResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "verificationRequired"],
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "verificationRequired": {
            "type": "boolean",
            "description": "The old email remains active until the new email is confirmed."
          }
        }
      },
      "GuestSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trialState", "activeConversionId"],
        "properties": {
          "trialState": {
            "type": "string",
            "enum": ["available", "reserved", "consumed"]
          },
          "activeConversionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Reserved conversion only; null when available or consumed. Keep an existing result ID separately."
          }
        }
      },
      "EmptyRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-converter.sid",
        "description": "HttpOnly; Secure; SameSite=Lax; Path=/; no Domain. Development-only loopback HTTP uses converter.dev.sid. Redis sessions: anonymous 15 minutes, authenticated idle 30 minutes and absolute 7 days."
      },
      "guestCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-converter.guest",
        "description": "Opaque capability; Secure, HttpOnly, SameSite=Lax, Path=/, no Domain. Local loopback HTTP uses converter.dev.guest. Fixed configurable lifetime (default 30 days), never renewed by bootstrap/login/logout."
      }
    },
    "responses": {
      "Auth400": {
        "description": "Invalid DTO or invalid/expired/consumed token",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "enum": ["no-store"]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Auth401": {
        "description": "Authentication required or invalid credentials; explicit X-API-Key is rejected",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "enum": ["no-store"]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Auth403": {
        "description": "Origin/CSRF/current password rejected or email is not verified",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "enum": ["no-store"]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Auth429": {
        "description": "Distributed rate limit exceeded",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "enum": ["no-store"]
            }
          },
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Seconds until retry."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Auth503": {
        "description": "Required service unavailable; requests fail closed",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "enum": ["no-store"]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
