{
  "name": "file-converter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "File Converter SaaS monorepo foundation",
  "engines": {
    "node": ">=24.11.1 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@converter/web",
    "dev:api": "npm run dev:api --workspace=@converter/backend",
    "dev:worker": "npm run dev:worker --workspace=@converter/backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0 && npm run lint:config",
    "lint:config": "node --test tests/lint/*.test.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace=@converter/backend",
    "test:e2e": "node scripts/playwright.mjs test",
    "test:e2e:install": "node scripts/playwright.mjs install chromium",
    "db:validate": "npm run db:validate --workspace=@converter/backend",
    "db:generate": "npm run db:generate --workspace=@converter/backend",
    "contracts:generate": "npm run generate --workspace=@converter/contracts",
    "contracts:check": "npm run generate:check --workspace=@converter/contracts",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "infra:config": "docker compose --env-file .env.example -f infra/compose.yaml config --quiet",
    "infra:production:config": "docker compose --env-file .env.production -f infra/compose.production.yaml config --quiet",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:integration && npm run db:validate && npm run contracts:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
