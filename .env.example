# Development-only defaults. Copy to .env; never use these in production.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
POSTGRES_USER=converter
POSTGRES_PASSWORD=converter-local-only
POSTGRES_DB=converter
DATABASE_URL=postgresql://converter:converter-local-only@127.0.0.1:5432/converter
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=10000
REDIS_URL=redis://127.0.0.1:6379
REDIS_NAMESPACE=converter
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=converter-local
S3_ACCESS_KEY_ID=converter-local
S3_SECRET_ACCESS_KEY=converter-local-only
S3_FORCE_PATH_STYLE=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=converter@example.test
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
INFRA_TIMEOUT_MS=5000
HEALTH_CHECK_INTERVAL_MS=5000
SHUTDOWN_TIMEOUT_MS=20000
# Required when authentication is implemented; never expose through VITE_*.
SESSION_SECRET=
LIBREOFFICE_BIN=libreoffice
WORKER_TEMP_DIR=
# Vite values are public.
VITE_API_BASE_URL=/api/v1
